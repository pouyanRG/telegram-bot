		{
			"label": "Set local session secret",
			"type": "shell",
			"command": "node",
			"args": [
				"-e",
				"const fs=require('node:fs'); const crypto=require('node:crypto'); const p='my-bot/.env.local'; let s=fs.readFileSync(p,'utf8'); if (/^SESSION_SECRET=/m.test(s)) { console.log('SESSION_SECRET already exists'); } else { s += (s.endsWith('\\n') ? '' : '\\n') + 'SESSION_SECRET=' + crypto.randomBytes(32).toString('hex') + '\\n'; fs.writeFileSync(p,s); console.log('SESSION_SECRET added to .env.local'); }"
			],
