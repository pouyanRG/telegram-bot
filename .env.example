BOT_TOKEN=توکن_از_BotFather
WEBHOOK_SECRET=یک_رشته_تصادفی_طولانی
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
APP_URL=https://YOUR-APP.vercel.app
ADMIN_PASSWORD=یک_رمز_قوی_برای_پنل_مدیریت
SESSION_SECRET=یک_رشته_تصادفی_۶۴_کاراکتری

# آیدی عددی تلگرام صاحب ربات (ادمین اصلی). بدون آن هیچ ادمین اصلی‌ای وجود ندارد.
OWNER_ID=

GEMINI_API_KEY=
# اختیاری؛ کلیدهای اضافی با کاما جدا شوند. اگر هر دو متغیر تنظیم باشند همه‌ی کلیدهای یکتا بررسی می‌شوند.
# سهمیه‌ی Gemini بر اساس پروژه‌ی Google است، نه تعداد API key.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite
TOKENS_DAILY_FREE=
TOKENS_DAILY_PRO=

# اختیاری
COINGECKO_API_KEY=
# سقف روزانه‌ی جستجوی ارز برای هر کاربر (پیش‌فرض ۳۰)
LIMIT_COIN=
# تعداد اتصال همزمان به دیتابیس در هر instance (پیش‌فرض ۳)
DB_POOL_MAX=
# برای کارهای طولانی مثل تبدیل رسانه، اول 200 به تلگرام داده می‌شود و پردازش در پس‌زمینه ادامه می‌یابد
WEBHOOK_ACK_FIRST=1

# Upstash Redis (rate limit)
KV_REST_API_URL=
KV_REST_API_TOKEN=